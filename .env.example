# === 大模型配置 ===
# 必填：至少填一个 API Key（根据你用的 provider）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

LLM_PROVIDER=deepseek        # deepseek / openai / claude
LLM_MODEL=deepseek-v4-flash   # deepseek-v4-flash / gpt-4o / claude-sonnet-4

# === 数据库 ===
# SQLite（默认，本地开发）：
# DATABASE_URL=sqlite:///data/film_companion.db
# PostgreSQL（生产环境）：
# DATABASE_URL=postgresql+asyncpg://filmuser:filmpass@localhost:5432/film_companion

# === 服务端口 ===
# PORT=8080
